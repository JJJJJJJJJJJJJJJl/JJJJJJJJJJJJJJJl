<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Instagram Time Monitor"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:textColor="#000000" />

    <TextView
        android:id="@+id/descriptionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Get alerted after 5 minutes on Instagram"
        android:textSize="16sp"
        android:layout_marginBottom="32dp"
        android:textColor="#666666"
        android:gravity="center" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Not started"
        android:textSize="18sp"
        android:layout_marginBottom="24dp"
        android:textColor="#333333"
        android:padding="12dp"
        android:background="#F0F0F0"
        android:gravity="center" />

    <Button
        android:id="@+id/permissionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grant Usage Access Permission"
        android:textSize="16sp"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#FF9800" />

    <Button
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Monitoring"
        android:textSize="16sp"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#4CAF50" />

    <Button
        android:id="@+id/stopButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop Monitoring"
        android:textSize="16sp"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#F44336" />

    <Button
        android:id="@+id/refreshButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Refresh Debug Info"
        android:textSize="14sp"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#2196F3" />

    <TextView
        android:id="@+id/debugText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Debug info will appear here"
        android:textSize="12sp"
        android:textColor="#333333"
        android:padding="12dp"
        android:background="#E8F5E9"
        android:fontFamily="monospace"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This app monitors when you use Instagram\nand alerts you after 5 minutes."
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:textColor="#999999"
        android:gravity="center" />

</LinearLayout>
